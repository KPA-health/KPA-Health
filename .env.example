# =============================================================================
# Copie este archivo como .env y ajuste los valores:   cp .env.example .env
# .env contiene credenciales: NUNCA lo suba al repositorio (ya está en .gitignore).
#
# Mínimo para arrancar:
#   - Sin modelo local: ponga su API key en CLOUD_OPENAI_API_KEY (OpenRouter, gratis).
#   - Con modelo local: instale Ollama y ejecute `ollama pull qwen3:8b`.
#   Si el modo local no está disponible, la interfaz cambia sola al modo nube.
# =============================================================================

# ---------------------------------------------------------------- Base de datos
DATABASE_PATH=hospital.db
# "auto" = el "hoy" del sistema es el último ingreso registrado en el HIS.
# También acepta una fecha fija: 2026-09-21 14:33:44
REFERENCE_DATETIME=auto

# ------------------------------------------------------------------------- API
# ---- Login con JWT y roles (admin: todo · user: dashboard, asistente e ingresos)
AUTH_ENABLED=true
# Secreto para firmar los tokens. Genere uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si queda vacío se usa uno temporal y las sesiones se cierran al reiniciar el servidor.
JWT_SECRET=
# Duración de la sesión (minutos)
JWT_EXPIRE_MINUTES=480
# Usuarios iniciales (se crean la primera vez que arranca el backend). CAMBIE las contraseñas.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin
AUTH_USER_USERNAME=usuario
AUTH_USER_PASSWORD=usuario
# Bloqueo temporal tras intentos fallidos de login
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300

# Secreto para el hash (HMAC-SHA256) de documentos de identidad. CÁMBIELO en producción.
PRIVACY_SALT=kpa-health-hslv-demo-salt-cambiar-en-produccion
CORS_ORIGINS=*
# Sirve la SPA (capa de Vista) en http://localhost:8000/
SERVE_FRONTEND=true
# Carpeta de la SPA (relativa a la raíz del proyecto)
FRONTEND_DIR=frontend
MAX_UPLOAD_MB=250

# ------------------------------------------------------------ Asistente IA
# Modo por defecto cuando la interfaz no envía uno: local | cloud
# (use cloud si no tiene Ollama instalado)
AI_DEFAULT_MODE=local
# Si el modo elegido falla, ¿usar el otro? (false = los datos nunca salen a la nube sin pedirlo)
AI_ALLOW_FALLBACK=false
# Segunda llamada al LLM para redactar la respuesta en lenguaje natural
AI_SUMMARIZE_RESULTS=true
AI_MAX_ROWS=200
AI_SQL_TIMEOUT_SECONDS=10
AI_MAX_REPAIR_ATTEMPTS=1
LLM_TIMEOUT_SECONDS=90

# ------------------------------------------------ Modo LOCAL (Qwen 3 8B)
# ollama | openai_compatible (LM Studio, vLLM, llama.cpp server)
LOCAL_PROVIDER=ollama
LOCAL_MODEL=qwen3:4b-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
# Razonamiento de Qwen3: auto (recomendado) | true | false
OLLAMA_THINK=auto
# Solo si LOCAL_PROVIDER=openai_compatible (LM Studio usa el puerto 1234)
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_OPENAI_API_KEY=lm-studio

# ------------------------------------------------- Modo NUBE
# openai_compatible (OpenRouter, Groq, OpenAI...) | gemini
CLOUD_PROVIDER=openai_compatible
# OpenRouter (gratis): cree su key en https://openrouter.ai -> Settings -> Keys
CLOUD_OPENAI_BASE_URL=https://openrouter.ai/api/v1
CLOUD_OPENAI_API_KEY=f
CLOUD_OPENAI_MODEL=openrouter/free

# Solo si CLOUD_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high (vacío = valor por defecto del modelo)
GEMINI_THINKING_LEVEL=low

# ------------------------------------------ Voz a texto (Whisper 100 % local)
# Requiere faster-whisper (incluido en requirements.txt). En servidores sin él: false
VOICE_ENABLED=true
# tiny | base | small | medium  (small = mejor equilibrio precisión/velocidad en español)
WHISPER_MODEL=small
# cpu (recomendado: no compite por VRAM con el LLM local) | cuda | auto
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Cargar el modelo en segundo plano al arrancar (evita la espera en la primera transcripción)
WHISPER_PRELOAD=true
VOICE_MAX_SECONDS=60
VOICE_MAX_MB=10
# Si el audio se detecta en otro idioma con probabilidad >= este umbral, se rechaza (solo español)
VOICE_MIN_LANGUAGE_PROBABILITY=0.75
