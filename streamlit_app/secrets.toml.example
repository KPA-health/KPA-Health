# =============================================================================
# Copie este contenido en Streamlit Cloud: App -> Settings -> Secrets.
# (En local: .streamlit/secrets.toml — ya está en .gitignore. Sin él se usa .env.)
# Son las mismas variables del .env: la app las copia al entorno al arrancar.
# =============================================================================

# ---- Seguridad (OBLIGATORIO cambiar) ----------------------------------------
JWT_SECRET = "genere-uno-con: python -c 'import secrets; print(secrets.token_urlsafe(48))'"
PRIVACY_SALT = "otro-secreto-largo-y-aleatorio"
AUTH_ENABLED = "true"
AUTH_ADMIN_USERNAME = "admin"
AUTH_ADMIN_PASSWORD = "CambieEsta2026*"
AUTH_USER_USERNAME = "usuario"
AUTH_USER_PASSWORD = "CambieEsta2026*"

# ---- Base de datos (se construye desde data/ en el primer arranque) ---------
DATABASE_PATH = "hospital.db"
REFERENCE_DATETIME = "auto"

# ---- Asistente IA -----------------------------------------------------------
# "cloud" es lo más seguro por defecto: el modo local depende de que su túnel esté arriba.
AI_DEFAULT_MODE = "cloud"
AI_ALLOW_FALLBACK = "false"
LLM_TIMEOUT_SECONDS = "90"
VOICE_ENABLED = "false"

# ---- Modo NUBE: OpenAI (o OpenRouter/Groq, misma API) -----------------------
CLOUD_PROVIDER = "openai_compatible"
CLOUD_OPENAI_BASE_URL = "https://api.openai.com/v1"
CLOUD_OPENAI_API_KEY = "sk-..."
CLOUD_OPENAI_MODEL = "gpt-4o-mini"
# OpenRouter:  CLOUD_OPENAI_BASE_URL = "https://openrouter.ai/api/v1"  y  CLOUD_OPENAI_MODEL = "openrouter/free"

# ---- Modo LOCAL: su Ollama expuesto con un túnel (ver README, sección Streamlit)
# Usuario y clave del túnel van en la URL (Basic Auth); nunca se muestran en la interfaz.
LOCAL_PROVIDER = "ollama"
LOCAL_MODEL = "qwen3:4b-q4_K_M"
OLLAMA_BASE_URL = "https://kpa:clave-del-tunel@su-subdominio.ngrok-free.app"
OLLAMA_KEEP_ALIVE = "30m"
OLLAMA_NUM_CTX = "8192"
OLLAMA_THINK = "auto"
